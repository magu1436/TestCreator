# Development MySQL connection (match the Compose database service).
MYSQL_DATABASE=testcreator
MYSQL_USER=testcreator
MYSQL_PASSWORD=local-dev-password
MYSQL_HOST=db
MYSQL_PORT=3306

# OCR API key
API_KEY=

# Optional initial administrator (set both to enable automatic creation).
# Existing accounts and passwords are never changed.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
