# Development database. Set your own password before starting Compose.
DB_BACKEND=mysql
DB_NAME=testcreator
DB_USER=testcreator
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306
# Required for tidb; optional for mysql. Absolute path inside the container.
DB_SSL_CA=

# OCR API key
API_KEY=

# Optional initial administrator (set both to enable automatic creation).
# Existing accounts and passwords are never changed.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
